        </mxCell>
        <mxCell id="legend-copy-5" value="&lt;b&gt;Resolve the public domain&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Route 53 points espresso.leozh.net to CloudFront. DNS is separate from the HTTP request path.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
