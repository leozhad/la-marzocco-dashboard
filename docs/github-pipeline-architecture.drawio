        <mxCell id="legend-badge-1" value="1" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
