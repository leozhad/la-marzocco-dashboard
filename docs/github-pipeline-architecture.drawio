        </mxCell>
        <mxCell id="legend-copy-1" value="&lt;b&gt;Fetch GitHub source&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The configured source action watches leozhad/la-marzocco-dashboard:main through a CodeStarSourceConnection action.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="120" width="538" height="90" />
