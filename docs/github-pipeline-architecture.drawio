        <mxCell id="pipeline-scope" value="Arrows show pipeline stage order and artifact flow.&lt;br&gt;CodePipeline starts the CloudFormation and updater actions." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
