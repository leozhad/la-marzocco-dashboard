        </mxCell>
        <mxCell id="legend-copy-1" value="&lt;b&gt;Record the source revision&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Commit and push to the private gitlab remote. Archive that exact committed revision; exclude local untracked files.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="120" width="538" height="90" />
        </mxCell>
        <mxCell id="step-2" value="2" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="480" width="28" height="28" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="245" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-copy-2" value="&lt;b&gt;Stage the build input&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Upload source.zip under manual-deployments/&amp;lt;commit&amp;gt;/ in the existing private S3 artifact bucket.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="245" width="538" height="90" />
        </mxCell>
        <mxCell id="step-3" value="3" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="260" width="28" height="28" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="370" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-copy-3" value="&lt;b&gt;Start the managed build&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;An operator starts CodeBuild with per-build S3 source/artifact overrides. The saved project remains CodePipeline-backed.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="370" width="538" height="90" />
        </mxCell>
        <mxCell id="step-4" value="4" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="260" width="28" height="28" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="495" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-copy-4" value="&lt;b&gt;Test and package&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CodeBuild runs Python and Node tests and packages the Python module, dependencies and web/ in lambda-deployment-package.zip.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="495" width="538" height="90" />
        </mxCell>
        <mxCell id="step-5" value="5" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="440" width="28" height="28" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="620" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-copy-5" value="&lt;b&gt;Check the release artifact&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Download the output and compare the packaged application files with the committed source. Retain the prior Lambda ZIP for rollback.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="620" width="538" height="90" />
        </mxCell>
        <mxCell id="step-6" value="6" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="270" y="745" width="28" height="28" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="745" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-copy-6" value="&lt;b&gt;Update and verify&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Use the Lambda revision ID to guard the code update, invoke the collector, and verify its response plus the public HTML and JSON.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=light-dark(#232F3E,#F5F5F5);align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1432" y="745" width="538" height="90" />
